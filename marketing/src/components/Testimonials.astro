---
import copy from "../data/copy.es.json";
const { testimonials } = copy;
---

<section class="testimonials" aria-labelledby="testimonials-h2">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Testimonios</span>
      <h2 id="testimonials-h2">Salones que ya están en piloto automático</h2>
    </div>
    <div class="testimonials__grid">
      {testimonials.map((t) => (
        <article class="testimonial">
          <div class="testimonial__avatar" aria-hidden="true">
            <span>{t.name.slice(0, 1)}</span>
          </div>
          <blockquote class="testimonial__quote">
            <p>"{t.quote}"</p>
          </blockquote>
          <footer class="testimonial__footer">
            <cite class="testimonial__name">{t.name}</cite>
            <div class="testimonial__kpi">{t.kpi}</div>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials {
    padding: 96px 0;
    background: var(--color-surface);
  }
  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 48px;
  }
  .section-header h2 {
    margin-bottom: 0;
  }
  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .testimonial {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 32px 28px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .testimonial__avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, #4f46e5, #8b5cf6);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    font-weight: 700;
  }
  .testimonial__quote {
    margin: 0;
    flex: 1;
  }
  .testimonial__quote p {
    font-size: 16px;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }
  .testimonial__footer {
    border-top: 1px solid var(--color-border);
    padding-top: 12px;
  }
  .testimonial__name {
    font-style: normal;
    font-weight: 600;
    color: var(--color-text);
    font-size: 14px;
    display: block;
    margin-bottom: 4px;
  }
  .testimonial__kpi {
    display: inline-block;
    background: var(--color-brand-soft);
    color: var(--color-brand);
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
  }
  @media (max-width: 880px) {
    .testimonials__grid {
      grid-template-columns: 1fr;
    }
    .testimonials {
      padding: 64px 0;
    }
  }
</style>
