---
import BaseLayout from "../layouts/BaseLayout.astro";
import planMatrix from "../data/planMatrix.json";

/**
 * Names and prices come from planMatrix.json (the home reads it too), which
 * the backend's plan-catalog-drift spec checks against what the panel and
 * Stripe charge. This page used to hard-code 29 / 59 / 119 EUR, "hasta 5
 * salones" and unlimited professionals on Pro: a salon saw 29 EUR and was
 * charged 49 EUR. The comparison rows below say what each plan does in
 * the panel (packages/backend/src/payments/services/subscriptions.service.ts).
 */
const rows: Record<string, Array<{ label: string; value: string }>> = {
  esencial: [
    { label: "Locales", value: "1" },
    { label: "Agenda y clientas", value: "Ilimitadas" },
    { label: "Profesionales", value: "Hasta 4" },
    { label: "Recepcionista IA", value: "500 mensajes al mes (unas 70 conversaciones)" },
    { label: "Canales de la recepcionista", value: "Web y WhatsApp" },
    { label: "Facturas y rectificativas", value: "✓" },
    { label: "Recordatorios por WhatsApp y email", value: "✓" },
    { label: "Email marketing", value: "Add-on" },
    { label: "Campañas de WhatsApp", value: "—" },
    { label: "Fidelización y tarjetas regalo", value: "Add-on" },
    { label: "Multi-local e informes consolidados", value: "—" },
    { label: "Soporte", value: "Email" },
  ],
  pro: [
    { label: "Locales", value: "1" },
    { label: "Agenda y clientas", value: "Ilimitadas" },
    { label: "Profesionales", value: "Hasta 10" },
    { label: "Recepcionista IA", value: "2.000 mensajes al mes (unas 280 conversaciones)" },
    { label: "Canales de la recepcionista", value: "Web, WhatsApp, Messenger, Instagram y Telegram" },
    { label: "Facturas y rectificativas", value: "✓" },
    { label: "Recordatorios por WhatsApp y email", value: "✓" },
    { label: "Email marketing", value: "✓" },
    { label: "Campañas de WhatsApp", value: "✓" },
    { label: "Fidelización y tarjetas regalo", value: "✓" },
    { label: "Multi-local e informes consolidados", value: "—" },
    { label: "Soporte", value: "Prioritario" },
  ],
  empresa: [
    { label: "Locales", value: "Desde 1 (precio por local)" },
    { label: "Agenda y clientas", value: "Ilimitadas" },
    { label: "Profesionales", value: "Ilimitados" },
    { label: "Recepcionista IA", value: "3.000 mensajes al mes por local (unas 420 conversaciones)" },
    { label: "Canales de la recepcionista", value: "Web, WhatsApp, Messenger, Instagram y Telegram" },
    { label: "Facturas y rectificativas", value: "✓" },
    { label: "Recordatorios por WhatsApp y email", value: "✓" },
    { label: "Email marketing", value: "✓" },
    { label: "Campañas de WhatsApp", value: "✓" },
    { label: "Fidelización y tarjetas regalo", value: "✓" },
    { label: "Multi-local e informes consolidados", value: "✓" },
    { label: "Soporte", value: "Account manager" },
  ],
};

const plans = planMatrix.plans.map((p) => ({
  id: p.id,
  name: p.name,
  price: p.price,
  perLocation: p.period === "month_per_location",
  blurb: p.tagline,
  featured: p.featured,
  features: rows[p.id] ?? [],
}));

const priceText = (p: (typeof plans)[number]) =>
  `${p.name} ${p.price} €/mes${p.perLocation ? " por local" : ""}`;
const description = `Tres planes para tu salón: ${plans.map(priceText).join(", ")}. 14 días gratis sin tarjeta.`;

const faq = [
  {
    q: "¿Cuánto dura la prueba gratuita?",
    a: "14 días con todo el plan Pro (la recepcionista IA, con 500 mensajes durante la prueba). No pedimos tarjeta de crédito. Si al cabo de 14 días no has añadido un método de pago, la cuenta pasa a modo lectura (puedes exportar tus datos, pero no emitir facturas ni registrar citas nuevas).",
  },
  {
    q: "¿Puedo cancelar cuando quiera?",
    a: "Sí, desde el panel de facturación. Conservas acceso de lectura durante 30 días para exportar todos tus datos y los de tus clientas.",
  },
  {
    q: "¿Necesito un certificado digital para facturar?",
    a: "No. Las facturas se emiten en KiraRoom sin certificado. El envío a la AEAT (Verifactu, TicketBAI) todavía no está disponible.",
  },
  {
    q: "¿Qué pasa con mis datos si dejo de pagar?",
    a: "Tus datos siguen siendo tuyos. Cuando tu cuenta pasa a solo lectura (impago, cancelación o fin de la prueba) puedes exportarlos durante 30 días; después se anonimizan, 60 días después del final, con un aviso por email 7 días antes. Las facturas emitidas se conservan 4 años, como exige la normativa fiscal.",
  },
];
---

<BaseLayout
  title="Precios"
  description={description}
>
  <section class="section-tight">
    <div class="container pricing-hero">
      <span class="eyebrow">Precios</span>
      <h1>Un precio para cada salón</h1>
      <p>
        Sin sorpresas, sin costes ocultos. Empieza con 14 días gratis y
        cambia de plan cuando crezcas.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-3 pricing-grid">
        {plans.map((p) => (
          <article class:list={["card", "price", p.featured && "card-featured"]}>
            {p.featured && <div class="price__badge">Más popular</div>}
            <h3>{p.name}</h3>
            <div class="price__amount">
              <span class="price__currency">€</span>
              <span class="price__value">{p.price}</span>
              <span class="price__suffix">{p.perLocation ? "/local/mes" : "/mes"}</span>
            </div>
            <p class="muted">{p.blurb}</p>
            <table class="price__table">
              <tbody>
                {p.features.map((f) => (
                  <tr>
                    <th scope="row">{f.label}</th>
                    <td>{f.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <a
              href={`https://app.kiraroom.net/signup?plan=${p.id}`}
              class:list={["btn", p.featured ? "btn-primary" : "btn-secondary"]}
            >
              Empezar con {p.name}
            </a>
          </article>
        ))}
      </div>
      <p class="pricing-footnote muted">
        Factura mensual. Cancelas cuando quieras.
      </p>
    </div>
  </section>

  <section class="section section-faq">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2>Antes de decidirte</h2>
      </div>
      <dl class="faq">
        {faq.map((item) => (
          <div class="faq__item">
            <dt>{item.q}</dt>
            <dd>{item.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .pricing-hero {
    text-align: center;
    max-width: 720px;
  }
  .pricing-hero p {
    font-size: 18px;
  }
  .pricing-grid {
    align-items: stretch;
  }
  .price {
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .price__badge {
    position: absolute;
    top: -12px;
    right: 24px;
    background: var(--color-brand);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 999px;
  }
  .price__amount {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin: 8px 0 16px;
  }
  .price__currency {
    font-size: 24px;
    color: var(--color-text-subtle);
  }
  .price__value {
    font-size: 48px;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }
  .price__suffix {
    color: var(--color-text-subtle);
    font-size: 14px;
  }
  .price__table {
    width: 100%;
    border-collapse: collapse;
    margin: 16px 0 24px;
    font-size: 14px;
  }
  .price__table th,
  .price__table td {
    text-align: left;
    padding: 8px 0;
    border-top: 1px solid var(--color-border);
    vertical-align: top;
  }
  .price__table th {
    color: var(--color-text-muted);
    font-weight: 500;
  }
  .price__table td {
    color: var(--color-text);
    text-align: right;
  }
  .price__table tr:first-child th,
  .price__table tr:first-child td {
    border-top: none;
  }
  .pricing-footnote {
    text-align: center;
    margin-top: 32px;
  }

  .section-faq {
    background: var(--color-surface);
  }
  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 40px;
  }
  .faq {
    max-width: 760px;
    margin: 0 auto;
    display: grid;
    gap: 24px;
  }
  .faq__item {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 20px 24px;
  }
  .faq__item dt {
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 8px;
  }
  .faq__item dd {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>