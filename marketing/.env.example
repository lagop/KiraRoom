# .env.example — marketing site
# Only PUBLIC_* variables are exposed to the bundle as
# import.meta.env.PUBLIC_*. Set in Cloudflare Pages dashboard or
# .env locally for `astro dev`.

# SaaS dashboard URL — used by the header CTA + the privacy/tos links.
PUBLIC_APP_URL=https://app.kirastudio.com

# Cloudflare Web Analytics token. Enable Analytics in the Cloudflare
# dashboard (Pages → project → Analytics), copy the token from the
# snippet shown there, and paste it here. While unset, the analytics
# <script> is omitted from the HTML — zero JS, zero tracking.
PUBLIC_CF_ANALYTICS_TOKEN=

# Plausible Analytics domain (e.g. marketing.kirastudio.com). When
# unset, the Plausible <script> is omitted from the HTML. Plausible is
# privacy-first (no cookies, no fingerprinting) so it does not need
# LSSI/RGPD consent — but it is opt-in per project.
PUBLIC_PLAUSIBLE_DOMAIN=