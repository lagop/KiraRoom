# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="KiraRoom"

# Cloudflare Turnstile site key (public): shows the captcha on /signup,
# /forgot-password and /login after 3 failures. Empty = no captcha. Set it
# together with the backend's TURNSTILE_SECRET_KEY. Baked in at build time
# (Dockerfile build arg NEXT_PUBLIC_TURNSTILE_SITE_KEY).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Development
NODE_ENV=development

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=false