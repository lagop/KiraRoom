# Base de datos
DATABASE_URL="postgresql://username:password@localhost:5432/beauty_saas?schema=public"

# Autenticación
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
# 8h access token + 7d refresh. The frontend refreshes silently
# ~1 minute before expiry so the dashboard never sees a 401.
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS y Frontend
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Configuración del servidor
PORT=4000
NODE_ENV="development"

# Email (opcional para notificaciones)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# AWS S3 (opcional para almacenamiento de archivos)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="beauty-saas-files"

# Stripe (opcional para pagos)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Redis (para caché, sesiones y colas de notificaciones)
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379

# Twilio (para SMS y WhatsApp)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"
TWILIO_WHATSAPP_NUMBER="+14155238886"  # Número de WhatsApp de Twilio (ejemplo)
TWILIO_WEBHOOK_SECRET="your-twilio-webhook-secret"

# Resend (para emails)
RESEND_API_KEY="re_eii3R7gF_LCFZkvJ8tAiG6UdukadJXLbE"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Webhook secrets (para verificación de firmas)
RESEND_WEBHOOK_SECRET="your_resend_webhook_secret"
TWILIO_WEBHOOK_SECRET="your_twilio_webhook_secret"

# ============================================
# P0 — Widget / QR / Import / Consent / Reviews / WhatsApp
# ============================================

# HMAC signing secret for ICS calendar-feed tokens (run: openssl rand -base64 32)
ICS_TOKEN_SECRET="change_me_ics_token_secret"

# AES-256 key (32 bytes base64) for encrypting OAuth tokens at rest (run: openssl rand -base64 32)
META_TOKEN_ENCRYPTION_KEY="change_me_32_bytes_base64_encryption_key"

# Meta WhatsApp Cloud API (per-tenant OAuth; defaults below used as app-level fallback)
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="change_me_webhook_verify_token"
META_API_VERSION="v20.0"

# Google Business Profile OAuth (only required if API integration is added; deep-link review flow works without)
GOOGLE_BUSINESS_CLIENT_ID=""
GOOGLE_BUSINESS_CLIENT_SECRET=""

# ============================================
# P2A — Spanish fiscal compliance (Verifactu / TicketBAI / SII)
# ============================================

# Toggle between CI stub and live AEAT. Set to "real" in staging/prod
# ONLY AFTER the AEAT sandbox cert has been uploaded.
#   stub → fixtures return deterministic accepted responses
#   real → POST to AEAT_VERIFACTU_ENDPOINT
FISCAL_E2E_MODE=stub

# AEAT Verifactu (Real Decreto 1007/2023).
#   Pre-production: https://prewww2.aeat.es/wlpl/inwinvoc/ws.Suministro
#   Production:   https://www2.agenciatributaria.gob.es/wlpl/inwinvoc/ws.Suministro
AEAT_VERIFACTU_ENDPOINT=https://prewww2.aeat.es/wlpl/inwinvoc/ws.Suministro

# TicketBAI — one endpoint per diputación.
#   Bizkaia:  https://www.batuz.eus/qqtbai/api/v1/recepcion
#   Gipuzkoa: https://tbai.gipuzkoa.eus/qrattbai/api/v1/recepcion
#   Álava:    https://tbai.araba.eus/qrattbai/api/v1/recepcion
DIPUTACION_TBAI_BIZKAIA=https://prewww.batuz.eus/qqtbai/api/v1/recepcion
DIPUTACION_TBAI_GIPUZKOA=https://prewww.tbai.gipuzkoa.eus/qrattbai/api/v1/recepcion
DIPUTACION_TBAI_ALAVA=https://prewww.tbai.araba.eus/qrattbai/api/v1/recepcion

# Suministro Inmediato de Información (SII).
AEAT_SII_ENDPOINT=https://prewww2.aeat.es/static_files/common/internet/dep/aplicaciones/es/aeat/ssii/...

# OAuth state secret for the accounting integrations (Holded, Sage, A3, NCS).
# 16+ random chars in production. Refuses to start below 16 chars in
# NODE_ENV=production.
OAUTH_STATE_SECRET=""

# ============================================
# P2A-hardening — Puppeteer for AEAT-prescribed PDFs
# ============================================

# Set to "true" in CI to skip the Chromium download (~300MB). The PDF
# service falls back to the hand-rolled Courier layout when this is "true".
PUPPETEER_SKIP_DOWNLOAD=true
# Path to a pre-installed Chromium/Chrome. Leave empty in dev (puppeteer
# discovers a system install). In production Docker images, point this
# at /usr/bin/google-chrome.
PUPPETEER_EXECUTABLE_PATH=

# ============================================
# Final roadmap — KMS provider for envelope encryption
# ============================================

# "local" uses the env-based META_TOKEN_ENCRYPTION_KEY. "aws" uses AWS
# KMS via @aws-sdk/client-kms. When "aws", KIRA_KMS_KEY_ID must point
# to the master key ARN.
KIRA_KMS_PROVIDER=local
KIRA_KMS_KEY_ID=

# ============================================
# Zero-budget launch — observability (Sentry / GlitchTip + pino logs)
# ============================================

# Sentry-compatible DSN. GlitchTip accepts the Sentry SDK DSN format,
# so this works for both Sentry SaaS and the self-hosted GlitchTip in
# docker-compose.observability.yml. Leave blank in dev / CI to disable.
SENTRY_DSN=
GLITCHTIP_DSN=

# Trace sample rate (0.0 - 1.0). 0.1 = 10% of transactions traced.
SENTRY_TRACES_SAMPLE_RATE=0.1

# pino log level. In production the default is `info`; in dev `debug`.
# One JSON line per request, one per Logger.log() call.
LOG_LEVEL=

# ============================================
# Zero-budget launch — Sprint 2 (invites + SaaS-admin UX)
# ============================================

# Public base URL of the SaaS dashboard. Used to build magic-link
# URLs in InvitesService (tenant invites) and absolute billing URLs
# in the Stripe webhook handlers. Without this, the backend falls
# back to FRONTEND_URL, then http://localhost:3000, and emits a loud
# error log on every send. Set in production to the real hostname.
APP_BASE_URL=

# Access-token refresh-window. Consumed by InvitesService.acceptInvite
# (mirrors AuthService.generateTokens) and the /auth/refresh flow.
# Format: `${N}d` for days, `${N}m` for minutes.
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated allow-list for the global CORS middleware in main.ts.
# When unset / "*", every origin is allowed (with a warn-log). Use a
# comma-separated list of exact origins in production (no trailing slash).
CORS_ALLOWED_ORIGINS=

# ============================================
# Email sender configuration
# ============================================

# From-address used by EmailService when no template-specific value is
# set. Format: "KiraRoom <noreply@yourdomain.com>" or just
# "noreply@yourdomain.com" — Resend accepts both. The domain is also
# used to derive the List-Unsubscribe mailto: URI per RFC 8058.
EMAIL_FROM=

# Bug-report recipient (BugReportService.submit forwards every report
# here). Defaults to founder@kiraroom.com when unset.
FOUNDER_EMAIL=founder@kiraroom.com

# ============================================
# Virtual Receptionist — LLM provider
# ============================================

# Provider used by default. One of: openai | anthropic | google | llama.
DEFAULT_LLM_PROVIDER=openai

# Model for the default provider. Cheap + fast options:
#   openai:        gpt-4o-mini (cheap), gpt-4o (quality), gpt-4 (legacy)
#   anthropic:     claude-3-haiku (cheap), claude-3-5-sonnet, claude-3-opus
#   google:        gemini-2.0-flash (cheap), gemini-1.5-pro
# Override per-tenant via the VirtualReceptionistConfig.
DEFAULT_LLM_MODEL=gpt-4o-mini

# Output cap per reply. The system prompt asks for 3-4 sentence
# answers (~100-200 tokens). 500 leaves headroom for longer responses
# (summaries, confirmations). 4000 (the old default) just burned budget.
LLM_MAX_TOKENS=500

LLM_TEMPERATURE=0.7
LLM_TOP_P=1
LLM_FREQUENCY_PENALTY=0
LLM_PRESENCE_PENALTY=0

# Fallback provider when the primary fails (rate-limit / outage). Leave
# empty to disable automatic failover.
LLM_FALLBACK_PROVIDER=anthropic
LLM_FALLBACK_MODEL=claude-3-haiku

# Retry budget for transient LLM errors (429 / 5xx).
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_MS=1000
LLM_RETRY_MAX_DELAY_MS=10000
