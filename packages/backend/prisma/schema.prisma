// P0 Ã¢â‚¬â€ Append widgetInstanceId on Appointment. Lives next to the model
// (Appointment is defined earlier) so we keep the relation definitions here
// for Prisma to pick them up after regeneration.

// ----------------------------------------------------------------------------
// P1.3 Ã¢â‚¬â€ Onboarding wizard state
// ----------------------------------------------------------------------------

// Per-tenant progress through the guided onboarding flow.
// `steps` is a JSON map of stepKey -> { status, completedAt?, skippedAt?, dismissedAt? }
// where `status` is one of: 'pending' | 'done' | 'skipped' | 'dismissed'.
model OnboardingState {
  tenantId           String    @id
  currentStep        Int       @default(0)
  steps              Json      @default("{}")
  checklistDismissed Boolean   @default(false)
  finishedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("onboarding_states")
}

// Sprint 2 / 2.3 Ã¢â‚¬â€ one row per trial-expiry email sent. The unique
// (tenantId, daysLeft, trialEnd) constraint makes the daily cron
// idempotent: re-runs the same day don't double-email a tenant that
// has already received the T-3 or T-1 warning for the current trial.
model TrialNotificationLog {
  id       String   @id @default(uuid())
  tenantId String
  daysLeft Int /// 3 or 1
  trialEnd DateTime /// snapshot of Tenant.trialEnd at send time
  sentAt   DateTime @default(now())
  resendId String? /// Resend email id, for traceability
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, daysLeft, trialEnd])
  @@index([tenantId])
  @@map("trial_notification_logs")
}

// Catalog of onboarding steps. Tenant-independent; seeded idempotently.
model OnboardingStepDef {
  key          String          @id
  order        Int             @unique
  group        OnboardingGroup
  titleI18nKey String
  descI18nKey  String
  href         String?
  detectName   String
  defaultOrder Int             @default(0)
  enabled      Boolean         @default(true)

  @@map("onboarding_step_defs")
}

enum OnboardingGroup {
  linear_required
  linear_optional
  checklist_optional
}

// ----------------------------------------------------------------------------
// P1.4 Ã¢â‚¬â€ Proactive rebooking by client cadence
// ----------------------------------------------------------------------------

// Per-client cadence model: how often does this client typically return for
// each service? Only services with >= 3 completed visits are tracked.
model ClientCadence {
  clientId                  String    @id
  tenantId                  String
  byService                 Json      @default("{}")
  nextRecommendedReminderAt DateTime?
  recommendedServiceId      String?
  lastComputedAt            DateTime  @default(now())
  reminderSentFor           Json      @default("[]")
  optedOut                  Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  tenant                    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([nextRecommendedReminderAt])
  @@map("client_cadences")
}

// Individual rebooking reminders dispatched by the cron worker.
// `serviceId` is nullable for generic (non-service-specific) reminders.
model RebookingReminder {
  id                  String        @id @default(uuid())
  tenantId            String
  clientId            String
  serviceId           String?
  scheduledAt         DateTime
  sentAt              DateTime?
  channel             RebookChannel
  status              RebookStatus
  resultAppointmentId String?
  cancelledReason     String?
  // P2A-receptionist-advanced -- AI-suggested slot this reminder promotes.
  // Null for tenants in basic-reminder mode or when there isn't enough
  // history to make a confident proposal.
  proposedSlot        Json?
  createdAt           DateTime      @default(now())
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client              Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, scheduledAt])
  @@index([clientId, status])
  @@map("rebooking_reminders")
}

enum RebookChannel {
  email
  whatsapp
  both
}

// P2A-receptionist-advanced â€” virtual wait-list for fully-booked slots.
// Hook on `Appointment.cancel` -> match by service + professional +
// date window -> push notification (later). The list is only enabled
// when the tenant has `virtual_receptionist_advanced` unlocked.
model WaitList {
  id             String    @id @default(uuid())
  tenantId       String
  clientId       String
  serviceId      String
  professionalId String?
  // The window when the client is available. Both nullable = "anytime".
  earliestDate   DateTime?
  latestDate     DateTime?
  // Lifecycle. `waiting` is the active state.
  // `notified` means a slot opened and we told the client.
  // `cancelled` is terminal (client or system removed).
  // `fulfilled` means the client booked the appointment they wanted.
  status         String    @default("waiting")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  notifiedAt     DateTime?
  notes          String?
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, serviceId, professionalId])
  @@index([clientId])
  @@map("wait_list")
}

enum RebookStatus {
  scheduled
  sent
  cancelled
  failed
  booked
}

// ----------------------------------------------------------------------------
// P2A Ã¢â‚¬â€ Spanish fiscal compliance (Verifactu / TicketBAI / SII)
// ----------------------------------------------------------------------------

model Invoice {
  id       String @id @default(uuid())
  tenantId String

  /// NumeraciÃƒÂ³n
  series    String
  number    String
  issueDate DateTime

  /// Sujeto (cliente o tenant para facturas simplificadas)
  recipientType    InvoiceRecipient
  recipientId      String?
  recipientName    String
  recipientTaxId   String?
  recipientAddress Json?

  /// Importes (en cÃƒÂ©ntimos para evitar drift decimal)
  subtotalCents Int
  taxBreakdown  Json
  totalCents    Int
  currency      String @default("EUR")

  /// Estado general
  status InvoiceStatus @default(draft)

  /// Estado fiscal (AEAT / diputaciones)
  fiscalMode        FiscalMode          @default(none)
  fiscalStatus      InvoiceFiscalStatus @default(not_required)
  fiscalHash        String?
  fiscalQrUrl       String?
  fiscalXml         String?             @db.Text
  fiscalReference   String?
  fiscalError       String?             @db.Text
  fiscalSubmittedAt DateTime?

  /// Estado contable (P2B)
  accountingStatus     InvoiceAccountingStatus @default(not_synced)
  accountingExternalId String?
  accountingSyncedAt   DateTime?
  accountingError      String?                 @db.Text
  /// P2A Ã¢â‚¬â€ Fiscal retry chain tracking
  fiscalRetryCount     Int                     @default(0)
  /// Snapshot of issuer NIF at the time of issuance (immutable). For refund
  /// flows we keep this even if Tenant.taxId later changes.
  issuerTaxIdAtIssue   String?
  issuerNameAtIssue    String?

  /// Metadata
  sourceType InvoiceSource
  sourceId   String?
  notes      String?

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines     InvoiceLine[]

  @@unique([tenantId, series, number])
  @@index([tenantId, issueDate])
  @@index([tenantId, status])
  @@index([fiscalStatus])
  @@index([sourceType, sourceId])
  @@map("invoices")
}

