  taxId                    String?
  taxIdType                NifType?
  dateOfBirth              DateTime?
  gender                   Gender?
  profileImage             String?
  status                   ClientStatus             @default(active)
  preferredLanguage        String                   @default("es")
  preferredServices        Json                     @default("[]")
  preferredProfessionals   Json                     @default("[]")
  preferredTimes           Json                     @default("{}")
  communicationPreferences Json                     @default("{}")
  loyaltyPoints            Int                      @default(0)
  loyaltyTier              String                   @default("bronze") /// bronze, silver, gold, platinum
  totalSpent               Decimal                  @default(0)
  visitCount               Int                      @default(0)
  averageSpent             Decimal                  @default(0)
  firstVisit               DateTime                 @default(now())
  lastVisit                DateTime?
  lastReengagementSent     DateTime? /// Last time a re-engagement email was sent
  source                   String?
  allergies                Json                     @default("[]")
  medicalConditions        Json                     @default("[]")
  notes                    String?
  tags                     Json                     @default("[]")
  passwordHash             String?
  appointments             Appointment[]
  chatConversations        ChatConversation[]
  clientProfiles           ClientProfile[]
  payments                 Payment[]
  wallet                   ClientWallet?
  loyaltyMembers           LoyaltyMember[]
  orders                   Order[]
  /// Email campaigns
  emailCampaignRecipients  EmailCampaignRecipient[]
  tenant                   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notifications            Notification[]
  notificationPreference   NotificationPreference?
  /// P1.4 Ã¢â‚¬â€ Rebooking reminders sent to this client
  rebookingReminders       RebookingReminder[]

  /// P2A-receptionist-advanced -- this client is on the virtual wait-list.
  waitListEntries WaitList[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
