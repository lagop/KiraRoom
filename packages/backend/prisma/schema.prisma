generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                     String             @id @default(uuid())
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  name                   String             @unique
  slug                   String             @unique
  /// P2A Ã¢â‚¬â€ Spanish tax compliance: NIF/CIF/NIE del emisor (obligatorio si fiscalMode != 'none')
  taxId                  String?
  taxIdType              NifType?
  legalName              String?
  description            String?
  logo                   String?
  coverImage             String?
  website                String?
  email                  String?
  phone                  String?
  whatsapp               String?
  street                 String?
  city                   String?
  state                  String?
  postalCode             String?
  country                String             @default("ES")
  timezone               String             @default("Europe/Madrid")
  currency               String             @default("EUR")
  language               String             @default("es")
  dateFormat             String             @default("DD/MM/YYYY")
  timeFormat             String             @default("24h")
  /// Virtual Receptionist settings
  assistantName          String             @default("Kira")
  cancellationPolicy     String?
  minCancelHours         Int                @default(24)
  openingHours           Json               @default("{}")
  /// Subscription
  plan                   SubscriptionPlan
  subscriptionStatus     SubscriptionStatus
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  trialEnd               DateTime?
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  /// Plan rev3: cancellation lifecycle + add-ons + multi-location
  cancelledAt            DateTime?
  readOnlyUntil          DateTime?
  /// Sprint 2 / 2.2 Ã¢â‚¬â€ payment-failure grace lifecycle. Set on the
  /// first Stripe `invoice.payment_failed` webhook; cleared on the
  /// next successful payment. When `gracePeriodEndsAt < now` the
  /// daily GracePeriodScheduler flips status to `suspended`.
  paymentFailedAt        DateTime?
  gracePeriodEndsAt      DateTime?
  /// Soft-delete (rev): when set, the tenant is hidden from SaaS listings
  /// but its data (users, appointments, payments, etc.) is preserved so
  /// an accidental delete can be reversed via Prisma Studio.
  deletedAt              DateTime?
  /// P2A-ia-fairuse - virtual receptionist usage counter (Esencial cap)
  aiConversationsUsed    Int                @default(0)
  aiConversationsResetAt DateTime?
  /// Saas-owner-configurable: how the assistant reacts to cap overflows
  /// degrade (default) -> FAQ cache only, no LLM.
  /// notify           -> LLM still runs, warn tenant next login.
  /// allow            -> soft cap, just log.
  aiFairUseAction        AiFairUseAction    @default(degrade)
  /// P2A-receptionist-advanced - persona/voice + multichannel config.
  receptionistPersonaId  String?

  /// P2A-plans-v2 - add-ons purchased by this tenant.
  tenantAddOns        TenantAddOn[]
  /// P2A-plans-v2 - message credit wallet (message_bundles add-on).
  messageCreditWallet MessageCreditWallet?

  addons                        Json                     @default("{}")
  maxLocations                  Int                      @default(1)
  /// Stripe Configuration (per-tenant)
  stripeMode                    String                   @default("test") /// "test" or "live"
  stripeTestSecretKey           String?
  stripeTestPublishableKey      String?
  stripeLiveSecretKey           String?
  stripeLivePublishableKey      String?
  /// Professional permissions
  allowProfessionalCrossBooking Boolean                  @default(false)
  features                      Json                     @default("{}")
  appointments                  Appointment[]
  clients                       Client[]
  professionals                 Professional[]
  services                      Service[]
  users                         User[]
  notifications                 Notification[]
  notificationTemplates         NotificationTemplate[]
  notificationPreferences       NotificationPreference[]
  chatConversations             ChatConversation[]
  clientProfiles                ClientProfile[]
  payments                      Payment[]
  wallets                       ClientWallet[]
  giftCards                     GiftCard[]
  loyaltyPrograms               LoyaltyProgram[]
  /// POS / Retail
  products                      Product[]
  productCategories             ProductCategory[]
  orders                        Order[]
  inventoryTransactions         InventoryTransaction[]
  /// Promotions
  promotions                    Promotion[]
  /// Email Campaigns
  emailCampaigns                EmailCampaign[]
  emailCampaignTemplates        EmailCampaignTemplate[]
  /// Social Integrations
  socialConnections             SocialConnection[]
  googleBusinessProfile         GoogleBusinessProfile?
  socialPosts                   SocialPost[]
  locations                     Location[]
  auditLogs                     AuditLog[]               @relation("AuditLogTenant")
  gdprRequests                  GdprRequest[]
  usedImpersonationTokens       UsedImpersonationToken[] @relation("UsedImpersonationTokenTenant")
  /// P0 Priority Zero Ã¢â‚¬â€ Widget / Import / Consent / Reviews / WhatsApp
  widgetInstances               WidgetInstance[]
  importJobs                    ImportJob[]
  consentForms                  ConsentForm[]
  consents                      Consent[]
  reviews                       Review[]
  whatsappConnection            WhatsAppConnection?
  whatsappCampaigns             WhatsAppCampaign[]
  invites                       TenantInvite[]

  /// Bug reports submitted from the in-app "Ã°Å¸ÂÅ¾ Report a bug" widget.
  /// Anonymous reports (no user, no tenant) are stored with both FKs null.
  bugReports BugReport[]

  // P2A-staff-copilot: per-user chat threads + pending-action queue
  assistantConversations AssistantConversation[]
  actionApprovals        ActionApproval[]
  copilotFeedback        CopilotFeedback[]

  // P2A-receptionist-advanced -- virtual wait-list for fully-booked slots.
  waitListEntries WaitList[]

  /// P1.3 Ã¢â‚¬â€ Onboarding wizard state (one row per tenant)
  onboardingState      OnboardingState?
  /// P1.4 Ã¢â‚¬â€ Rebooking per-tenant settings (analogous to `features` / `addons`)
  rebookingSettings    Json                   @default("{\"enabled\": false, \"leadDays\": 3, \"channelFallback\": \"both\", \"minVisits\": 3}")
  /// P1.4 Ã¢â‚¬â€ Cadence / reminder log relations
  clientCadences       ClientCadence[]
  rebookingReminders   RebookingReminder[]
  /// P2A Ã¢â‚¬â€ Fiscal Spain (Verifactu / TicketBAI / SII)
  fiscalMode           FiscalMode             @default(none)
  fiscalSettings       Json                   @default("{\"defaultSeries\": \"A\", \"defaultTaxRate\": 21, \"autoInvoiceAppointments\": false, \"diputacion\": null}")
  invoices             Invoice[]
  fiscalCertificates   FiscalCertificate[]
  fiscalSequences      FiscalSequence[]
  fiscalChainStates    FiscalChainState[]
  /// P2B Ã¢â‚¬â€ Accounting integrations (Holded / Sage)
  accountingConnection AccountingConnection?
  taxReports           TaxReport[]
  accountingSettings   Json                   @default("{\"provider\": null, \"enabled\": false, \"syncOnIssue\": true}")
  /// Sprint 2 / 2.3 Ã¢â‚¬â€ track which trial-expiry warnings (T-3, T-1)
  /// we've sent so the daily cron doesn't re-email a tenant who has
  /// already received the warning for this trial window.
  trialNotifications   TrialNotificationLog[]

  @@index([deletedAt])
  @@index([subscriptionStatus, deletedAt])
  @@index([deletedAt, plan])
  @@index([deletedAt, country])
  @@map("tenants")
}

model AddOn {
  id                String   @id @default(uuid())
  key               String   @unique
  name              String
  description       String?
  monthlyPriceCents Int?
  currency          String   @default("EUR")
  unlocks           Json     @default("[]")
  metered           Boolean  @default(false)
  stripePriceId     String?
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenantAddOns TenantAddOn[]

  @@map("add_ons")
}

model TenantAddOn {
  id                       String    @id @default(uuid())
  tenantId                 String
  addOnId                  String
  stripeSubscriptionItemId String?
  status                   String    @default("active")
  startedAt                DateTime  @default(now())
  currentPeriodEnd         DateTime?
  cancelledAt              DateTime?
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addOn                    AddOn     @relation(fields: [addOnId], references: [id], onDelete: Restrict)

  @@unique([tenantId, addOnId])
  @@index([tenantId])
  @@map("tenant_add_ons")
}

model MessageCreditWallet {
  tenantId              String    @id
  creditsRemaining      Int       @default(0)
  creditsPurchasedTotal Int       @default(0)
  creditsUsedTotal      Int       @default(0)
  lastTopupAt           DateTime?
  updatedAt             DateTime  @updatedAt
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("message_credit_wallet")
}

enum AiFairUseAction {
  /// Degrade to FAQ cache + human handoff. Default -- never hard-block.
  degrade
  /// Allow the LLM but warn the tenant on next login / show a soft banner.
  notify
  /// Allow without any UI signal (only log + billing side effect).
  allow
}

// Audit trail for sensitive actions performed by privileged users
// (notably: SaaS owners impersonating tenant owners, suspending tenants,
// and future platform-level actions). Append-only Ã¢â‚¬â€ never updated or
// deleted from the application code.
model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  actorId   String
  actorRole UserRole
  tenantId  String?
  action    String
  metadata  Json?
  actor     User     @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Restrict)
  tenant    Tenant?  @relation("AuditLogTenant", fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// One-shot consumption tracker for SaaS-owner-issued impersonation
// tokens. The `jti` is the primary key, so an atomic INSERT ... ON
// CONFLICT semantics gives us natural "first consume wins". The TTL
// of the JWT itself remains 60 s (see IMPERSONATION_TTL_SECONDS), but
// a token that has been used once can never be replayed Ã¢â‚¬â€ even
// before its natural expiry.
model UsedImpersonationToken {
  jti        String   @id
  tenantId   String
  consumedBy String
  consumedAt DateTime @default(now())
  tenant     Tenant?  @relation("UsedImpersonationTokenTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([consumedAt])
  @@map("used_impersonation_tokens")
}

// Single-use tenant onboarding invite (Sprint 2, Workstream 2.1).
// The SaaS admin mints a `TenantInvite` row when they want to bring a
// new salon onto the platform. The owner receives a magic link via
// email; clicking it opens a 3-step wizard (password, address,
// timezone) which atomically (a) creates the Tenant, (b) creates the
// owner User, (c) marks the invite accepted. Replay is impossible:
// once `acceptedAt` is set the row stays as an audit trail, and
// `token` is unique.
model TenantInvite {
  id          String           @id @default(uuid())
  tenantId    String?
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  firstName   String?
  lastName    String?
  tenantName  String /// pre-collected: name the SaaS admin chose
  role        UserRole         @default(owner)
  plan        SubscriptionPlan @default(esencial)
  token       String           @unique /// 256-bit random; also used as the magic-link slug
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String /// SaaS owner user id
  status      InviteStatus     @default(pending)
  /// Audit trail of the SaaS admin who minted the invite.
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([email])
  @@index([tenantId])
  @@index([status, expiresAt])
  @@index([invitedById])
  @@map("tenant_invites")
}

model User {
  id                       String                  @id @default(uuid())
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  tenantId                 String
  professionalId           String?                 @unique
  email                    String                  @unique
  firstName                String
  lastName                 String
  role                     UserRole
  isActive                 Boolean                 @default(true)
  isEmailVerified          Boolean                 @default(false)
  /// Sprint 2 / 2.3 Ã¢â‚¬â€ bounce handling. Set by the Resend webhook when a
  /// transactional or campaign email to this user bounces. Future
  /// transactional sends short-circuit and skip the recipient until
  /// the address is updated and the field is cleared manually.
  emailBouncedAt           DateTime?
  emailBounceReason        String?
  lastLoginAt              DateTime?
  passwordHash             String
  profileImage             String?
  phone                    String?
  twoFactorEnabled         Boolean                 @default(false)
  language                 String                  @default("es")
  twoFactorSecret          String?
  loginAttempts            Int                     @default(0)
  lockedUntil              DateTime?
  passwordResetToken       String?
  passwordResetExpires     DateTime?
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  preferences              Json                    @default("{}")
  permissions              Json                    @default("{}")
  tenant                   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional             Professional?
  notifications            Notification[]
  notificationPreference   NotificationPreference?
  auditLogs                AuditLog[]              @relation("AuditLogActor")
  bugReportsAuthored       BugReport[]             @relation("BugReportAuthor")
  assistantConversations   AssistantConversation[]
  actionApprovalsCreated   ActionApproval[]        @relation("ActionApprovalCreator")
  actionApprovalsResolved  ActionApproval[]        @relation("ActionApprovalResolver")
  copilotFeedbackAuthored  CopilotFeedback[]       @relation("CopilotFeedbackAuthor")

  @@unique([tenantId, email])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@index([email])
  @@index([professionalId])
  @@map("users")
}

