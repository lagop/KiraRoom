model ProfessionalService {
  id             String       @id @default(uuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  professionalId String
  serviceId      String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
  @@index([professionalId])
  @@index([serviceId])
}

model Appointment {
  id                     String              @id @default(uuid())
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  tenantId               String
  clientId               String
  serviceId              String
  professionalId         String
  scheduledDate          DateTime
  scheduledTime          String
  duration               Int
  endTime                String
  status                 AppointmentStatus   @default(pending)
  price                  Decimal
  currency               String              @default("EUR")
  paymentStatus          PaymentStatus       @default(pending)
  paymentMethod          String?
  stripePaymentIntentId  String?
  notes                  String?
  internalNotes          String?
  cancellationReason     String?
  cancellationPolicy     String?
  isRecurring            Boolean             @default(false)
  recurringSeriesId      String?
  parentAppointmentId    String?
  reminders              Json                @default("[]")
  checkInTime            DateTime?
  startTime              DateTime?
  completionTime         DateTime?
  addons                 Json                @default("[]")
  discount               Json                @default("{}")
  taxes                  Json                @default("[]")
  totalAmount            Decimal             @default(0)
  amountPaid             Decimal             @default(0)
  amountDue              Decimal             @default(0)
  source                 AppointmentSource   @default(online)
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  rating                 Int?
  review                 String?
  feedback               Json                @default("{}")
  location               AppointmentLocation @default(salon)
  address                String?
  travelFee              Decimal             @default(0)
  depositRequired        Boolean             @default(false)
  depositAmount          Decimal?
  depositPaid            Boolean             @default(false)
  depositPaymentIntentId String?
  /// Multi-location (plan Empresa)
  locationId             String?
  salonLocation          Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)

  /// Commission tracking
  commissionRate   Decimal?
  commissionAmount Decimal?  @default(0)
  commissionPaid   Boolean   @default(false)
  commissionDate   DateTime?

  /// Reminder tracking flags
  reminder24hSent   Boolean @default(false)
  reminder1hSent    Boolean @default(false)
  reviewRequestSent Boolean @default(false)

  /// P0 Ã¢â‚¬â€ Widget instance attribution
  widgetInstanceId String?
  widgetInstance   WidgetInstance? @relation(fields: [widgetInstanceId], references: [id], onDelete: SetNull)

  activities   AppointmentActivity[]
  payments     Payment[]
  services     AppointmentService[]
  client       Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professional Professional          @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service               @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, scheduledDate])
  @@index([tenantId, professionalId, scheduledDate])
  @@index([tenantId, clientId])
  @@index([status])
  @@index([paymentStatus])
  @@map("appointments")
}

model AppointmentActivity {
  id            String      @id @default(uuid())
  createdAt     DateTime    @default(now())
  appointmentId String
  action        String
  details       Json
  userId        String?
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([createdAt])
  @@map("appointment_activities")
}

// Enum for AppointmentService type
enum AppointmentServiceType {
  active /// Work being done (professional assigned)
  processing /// Waiting time (color processing, etc.) - professional is free
  continuation /// Continuation after processing (e.g., rinse after color)
}

// Enum for AppointmentService status
enum AppointmentServiceStatus {
  pending
  active
  processing /// Waiting time (color processing, etc.) - professional is free
  completed
  cancelled
}

// AppointmentService - decomposes appointments into work blocks
// One record per work block, not one per service
// Example: A coloring generates 3 records: application, processing (professional=NULL), rinse
model AppointmentService {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  appointmentId  String
  appointment    Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service       @relation(fields: [serviceId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  /// Timing
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?

  /// Type: active (work), processing (waiting - professional free), continuation (after processing)
  type AppointmentServiceType @default(active)

  /// For parallel services (e.g., manicure + pedicure at same time)
  isParallel Boolean @default(false)

  /// Order within the appointment
  order Int @default(0)

  /// Status
  status AppointmentServiceStatus @default(pending)

  /// Notes
  notes String?

  @@index([appointmentId])
  @@index([professionalId])
  @@index([scheduledStart])
  @@map("appointment_services")
}

enum SubscriptionPlan {
  esencial
  pro
  empresa
  /// Legacy aliases kept for backwards compatibility with existing rows;
  /// SaaSService.createTenant / webhook handlers map them to the new plans.
  basic
  professional
  advanced
  enterprise
}

enum SubscriptionStatus {
  active
  cancelled
  past_due
  suspended
  trialing
}

enum UserRole {
  saas_owner
  owner
  admin
  staff
  client
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

enum ClientStatus {
  active
  inactive
  blocked
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

enum LoyaltyTierType {
  bronze
  silver
  gold
  platinum
}

enum ServiceCategory {
  hair
  nails
  facial
  massage
  body
  other
}

enum AppointmentStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled
  no_show
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum AppointmentSource {
  online
  phone
  walk_in
  staff
  widget
  instagram
}

enum AppointmentLocation {
  salon
  client_home
  other
}

// ============================================
// Virtual Receptionist Models
// ============================================

model ChatConversation {
  id             String      @id @default(uuid())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tenantId       String
  clientId       String?
  salonId        String?
  conversationId String?
  /// P2A-receptionist-v2 H-4: web | whatsapp | facebook | instagram | telegram
  channel        ChatChannel @default(web)
  status         String      @default("active") /// active, completed, handoff
  totalMessages  Int         @default(0)
  hasHandoff     Boolean     @default(false)
  handoffUserId  String?
  handoffAt      DateTime?
  lastActivityAt DateTime    @default(now())
  context        Json        @default("{}")

  messages      ChatMessage[]
  intentHistory IntentHistoryItem[]
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client        Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([clientId])
  @@index([salonId])
  @@index([channel])
  @@index([status])
  @@index([lastActivityAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  conversationId  String
  role            String   @default("user") /// user or assistant
  content         String
  provider        String? /// openai, anthropic, google, llama
  model           String?
  responseTime    Int?
  intent          String?
  requiresHandoff Boolean  @default(false)
  metadata        Json     @default("{}")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([role])
  @@index([intent])
  @@map("chat_messages")
}

model IntentHistoryItem {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  conversationId String
  intent         String
  confidence     Float
  context        Json     @default("{}")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([intent])
  @@map("intent_history")
}

model ClientProfile {
  id                       String   @id @default(uuid())
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  tenantId                 String
  clientId                 String
  name                     String
  email                    String?
  phone                    String?
  preferences              Json     @default("{}")
  interactionHistory       Json     @default("[]")
  bookingHistory           Json     @default("[]")
  servicePreferences       Json     @default("[]")
  communicationPreferences Json     @default("{}")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientId])
  @@index([tenantId])
  @@index([clientId])
  @@map("client_profiles")
}

// Promotions & Discounts
model Promotion {
  id                   String        @id @default(uuid())
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  tenantId             String
  name                 String
  description          String?
  code                 String /// Discount code
  type                 PromotionType
  value                Decimal /// Percentage or fixed amount
  minOrderValue        Decimal? /// Minimum order value to apply
  maxUses              Int? /// Maximum total uses
  maxUsesPerClient     Int? /// Maximum uses per client
  usedCount            Int           @default(0)
  startDate            DateTime
  endDate              DateTime?
  isActive             Boolean       @default(true)
  /// Applicable service IDs (stored as JSON)
  applicableServiceIds Json          @default("[]")
  applicableProductIds Json          @default("[]")

  /// Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emailCampaigns EmailCampaign[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([code])
  @@index([isActive])
  @@map("promotions")
}

enum PromotionType {
  PERCENTAGE /// Percentage discount (e.g., 10% off)
  FIXED /// Fixed amount discount (e.g., Ã¢â€šÂ¬10 off)
  BUY_X_GET_Y /// Buy X get Y free
}

model PromotionUsage {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  promotionId    String
  clientId       String
  orderId        String?
  discountAmount Decimal
  appointmentId  String? /// Link to appointment if applicable

  @@index([promotionId])
  @@index([clientId])
  @@map("promotion_usage")
}

// ============================================
// Notification System Models
// ============================================

model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String

  /// Recipient - can be either User or Client
  userId   String?
  clientId String?

  /// Notification content
  type    NotificationType
  title   String
  message String
  data    Json             @default("{}") /// Typed data for deep linking

  /// Status
  isRead Boolean   @default(false)
  readAt DateTime?

  /// Soft delete / Archive
  archivedAt DateTime?

  /// Relations
  user       User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  client     Client?                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([tenantId])
  @@index([userId])
  @@index([clientId])
  @@index([tenantId, isRead])
  @@index([archivedAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  notificationId String?

  /// Channel information.
  /// P2A-receptionist-v2 H-4: extended to also accept the chat
  /// channels (web | whatsapp | facebook | instagram | telegram).
  channel String /// "email" | "sms" | "whatsapp" | "inApp" | "facebook" | "instagram" | "telegram"
  status  String /// "pending" | "sent" | "delivered" | "failed" | "bounced" | "opened"

  /// Recipient (for standalone delivery tracking without notification)
  recipient String?

  /// External tracking
  externalId    String? @unique /// Twilio/SendGrid message ID for webhooks
  error         String? /// Error message if failed
  failureReason String? /// Detailed failure reason

  /// Timestamps
  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?

  /// Relations
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([channel, status])
  @@index([externalId])
  @@map("notification_deliveries")
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String

  /// Template identification
  type        NotificationType
  slug        String /// e.g., "appointment_reminder_24h", "appointment_reminder_1h"
  name        String
  description String?

  /// Content templates
  titleTemplate   String /// Supports variables like {{clientName}}
  messageTemplate String

  /// Channel-specific templates
  emailSubject     String?
  emailBody        String? /// HTML template
  smsTemplate      String?
  whatsappTemplate String?

  /// Settings
  isActive Boolean @default(true)

  /// Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, slug])
  @@map("notification_templates")
}

model NotificationPreference {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String

  /// Recipient - one-to-one relations require unique fields
  userId   String? @unique
  clientId String? @unique

  /// Channel preferences per notification type
  preferences Json @default("{}")
  /// Example: { "appointment_reminder": { "inApp": true, "email": true, "sms": false, "whatsapp": false } }

  /// Relations
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

enum NotificationType {
  /// Appointment related
  appointment_created
  appointment_confirmed
  appointment_cancelled
  appointment_rescheduled
  appointment_reminder_24h
  appointment_reminder_1h
  appointment_completed
  appointment_no_show
  review_request

  /// Payment related
  payment_received
  payment_failed
  refund_processed

  /// Promotional
  promotion
  news
  special_offer

  /// System
  system_alert
  account_update
  password_change

  /// Professional specific
  new_appointment_assigned
  schedule_change
  new_message
}

// ============================================
// PAYMENT MODELS
// ============================================

model Payment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String

  /// Payment identification
  stripePaymentId String? @unique
  stripeInvoiceId String?
  amount          Int /// Amount in cents
  currency        String  @default("EUR")

  /// Payment type and status
  type   PaymentType
  status PaymentStatus @default(pending)
  method PaymentMethod @default(card)

  /// Client and appointment
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  /// For deposits
  isDeposit       Boolean @default(false)
  depositAmount   Int?
  remainingAmount Int?

  /// Additional info
  description String?
  metadata    Json    @default("{}")

  /// Stripe data
  receiptUrl     String?
  failureMessage String?

  /// Relations
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order        Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId      String?
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([tenantId])
  @@index([clientId])
  @@index([appointmentId])
  @@index([status])
  @@map("payments")
}

model PaymentTransaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  /// Transaction details
  type   TransactionType
  amount Int /// Amount in cents
  status TransactionStatus

  /// Stripe
  stripeChargeId   String? @unique
  stripeTransferId String?

  /// Notes
  note String?

  @@index([paymentId])
  @@map("payment_transactions")
}

model Refund {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  /// Refund details
  amount Int /// Amount in cents
  reason String?
  status RefundStatus @default(pending)

  /// Stripe
  stripeRefundId String? @unique

  /// Notes
  note    String?
  adminId String?

  @@index([paymentId])
  @@map("refunds")
}

model ClientWallet {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String
  clientId  String   @unique

  /// Balance
  balance     Int @default(0) /// Amount in cents
  totalEarned Int @default(0) /// Total loyalty points earned
  totalSpent  Int @default(0) /// Total loyalty points spent

  /// Loyalty points
  loyaltyPoints Int @default(0)

  /// Relations
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client       Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@unique([tenantId, clientId])
  @@index([tenantId])
  @@map("client_wallets")
}

model WalletTransaction {
  id        String       @id @default(uuid())
  createdAt DateTime     @default(now())
  walletId  String
  wallet    ClientWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  /// Transaction details
  type   WalletTransactionType
  amount Int /// Amount in cents or points
  points Int                   @default(0) /// Loyalty points

  /// Reference
  referenceType String? /// "payment" | "appointment" | "gift_card" | "loyalty_reward"
  referenceId   String?

  /// Description
  description String?

  /// Balance after
  balanceAfter Int

  @@index([walletId])
  @@map("wallet_transactions")
}

model GiftCard {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String

  /// Card details
  code           String @unique
  initialAmount  Int /// Amount in cents
  currentBalance Int /// Remaining amount in cents

  /// Status
  isActive  Boolean   @default(true)
  expiresAt DateTime?

  /// Optional: who bought and for whom
  purchasedById  String?
  recipientId    String?
  recipientEmail String?
  recipientName  String?

  /// Message
  message String?

  /// Relations
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions GiftCardTransaction[]

  @@index([tenantId])
  @@index([code])
  @@map("gift_cards")
}

model GiftCardTransaction {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  /// Transaction
  type   GiftCardTransactionType
  amount Int /// Amount in cents

  /// Reference
  paymentId String?

  /// Notes
  note String?

  @@index([giftCardId])
  @@map("gift_card_transactions")
}

model LoyaltyProgram {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String   @unique

  /// Program settings
  name        String  @default("Loyalty Program")
  description String?
  isActive    Boolean @default(true)

  /// Points earning rules
  pointsPerEuro Int @default(1) /// Points earned per EUR spent

  /// Points redemption
  pointsValueInCents  Int @default(1) /// 1 point = 1 cent
  minPointsRedemption Int @default(100) /// Minimum points to redeem

  /// Welcome bonus
  welcomePoints Int @default(0)

  /// Expiration
  pointsExpirationDays Int? /// Points expire after X days

  /// Relations
  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tiers   LoyaltyTier[]
  rewards LoyaltyReward[]
  members LoyaltyMember[]

  @@map("loyalty_programs")
}

model LoyaltyTier {
  id        String         @id @default(uuid())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  programId String
  program   LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  /// Tier info
  name             String /// Bronze, Silver, Gold, Platinum
  minPoints        Int    @default(0)
  pointsMultiplier Float  @default(1.0) /// 1.5 = 50% more points

  /// Benefits
  description String?
  benefits    Json    @default("[]")

  /// Relations
  members LoyaltyMember[]

  @@unique([programId, name])
  @@map("loyalty_tiers")
}

model LoyaltyMember {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId  String
  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  programId String
  program   LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  tierId    String?
  tier      LoyaltyTier?   @relation(fields: [tierId], references: [id], onDelete: SetNull)

  /// Stats
  lifetimePoints Int   @default(0)
  currentPoints  Int   @default(0)
  totalEarned    Int   @default(0)
  totalRedeemed  Int   @default(0)
  totalSpent     Float @default(0) /// Total euros spent

  /// Status
  status         LoyaltyMemberStatus @default(active)
  joinedAt       DateTime            @default(now())
  lastActivityAt DateTime?

  /// Relations
  redemptions      LoyaltyRedemption[]
  expirationPoints LoyaltyPointsExpiration[]

  @@unique([clientId, programId])
  @@map("loyalty_members")
}

model LoyaltyReward {
  id        String         @id @default(uuid())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  programId String
  program   LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  /// Reward info
  name        String
  description String?
  type        LoyaltyRewardType /// discount, free_service, product, voucher

  /// Value
  discountPercent Int?
  discountAmount  Int?
  freeServiceId   String?
  productId       String?
  voucherCode     String?

  /// Cost
  pointsCost Int

  /// Availability
  isActive           Boolean   @default(true)
  maxRedemptions     Int?
  currentRedemptions Int       @default(0)
  expiresAt          DateTime?

  /// Relations
  redemptions LoyaltyRedemption[]

  @@index([programId])
  @@map("loyalty_rewards")
}

model LoyaltyRedemption {
  id        String        @id @default(uuid())
  createdAt DateTime      @default(now())
  memberId  String
  member    LoyaltyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  rewardId  String
  reward    LoyaltyReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  /// Redemption details
  pointsSpent   Int
  valueReceived Int? /// Value in cents

  /// Status
  status RedemptionStatus @default(pending)
  usedAt DateTime?

  /// Reference
  appointmentId String?
  paymentId     String?

  @@index([memberId])
  @@index([rewardId])
  @@map("loyalty_redemptions")
}

model LoyaltyPointsExpiration {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  memberId String
  member   LoyaltyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// Expiring points
  points    Int
  expiresAt DateTime

  /// Status
  isExpired  Boolean @default(false)
  isRedeemed Boolean @default(false)

  @@index([memberId])
  @@index([expiresAt])
  @@map("loyalty_points_expiration")
}

// Enums for Payment
enum PaymentType {
  appointment
  deposit
  product
  service
  gift_card
  membership
  other
}

enum PaymentTransactionStatus {
  pending
  processing
  succeeded
  failed
  cancelled
  refunded
  partially_refunded
}

enum PaymentMethod {
  card
  cash
  bank_transfer
  wallet
  gift_card
  loyalty_points
}

enum TransactionType {
  charge
  refund
  transfer
  payout
}

enum TransactionStatus {
  pending
  succeeded
  failed
}

enum RefundStatus {
  pending
  processing
  succeeded
  failed
}

enum WalletTransactionType {
  credit /// Added to wallet (deposit, refund, etc.)
  debit /// Deducted from wallet (purchase, redemption)
  earned /// Loyalty points earned
  redeemed /// Loyalty points redeemed
  expired /// Points expired
  bonus /// Bonus points
}

enum GiftCardTransactionType {
  created /// Gift card created/purchased
  applied /// Applied to payment
  refunded /// Refunded back to gift card
  expired /// Gift card expired
}

enum LoyaltyMemberStatus {
  active
  suspended
  expired
}

enum LoyaltyRewardType {
  discount
  free_service
  product
  voucher
}

enum RedemptionStatus {
  pending
  completed
  cancelled
}

// ============================================
// PRODUCT / INVENTORY MODELS (POS Retail)
// ============================================

model Product {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String

  /// Product info
  name        String
  description String?
  sku         String? @unique
  barcode     String?

  /// Category
  category    String?
  subcategory String?

  /// Pricing
  price     Decimal  @default(0)
  costPrice Decimal? /// Wholesale cost
  currency  String   @default("EUR")

  /// Inventory
  trackInventory Boolean @default(true)
  quantity       Int     @default(0)
  lowStockAlert  Int     @default(5)

  /// Media
  imageUrl String?
  images   String[] /// Array of image URLs

  /// Status
  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  /// Tax
  taxRate Decimal? /// e.g., 0.21 for 21%

  /// Online store
  showOnline  Boolean  @default(false)
  onlinePrice Decimal?

  /// Loyalty
  earnPoints   Boolean @default(false)
  pointsEarned Int     @default(0)

  /// Relations
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems           ProductOrder[]
  InventoryTransaction InventoryTransaction[]

  @@index([tenantId])
  @@index([tenantId, category])
  @@index([sku])
  @@map("products")
}

model ProductCategory {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String

  name         String
  description  String?
  parentId     String?
  imageUrl     String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")

  @@index([tenantId])
  @@map("product_categories")
}

model ProductOrder {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  orderId    String
  productId  String
  quantity   Int     @default(1)
  unitPrice  Decimal
  totalPrice Decimal

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
  @@map("product_orders")
}

model Order {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String
  clientId  String?

  /// Order info
  orderNumber String      @unique
  status      OrderStatus @default(pending)
  type        OrderType   @default(sale)

  /// Pricing
  subtotal  Decimal @default(0)
  taxAmount Decimal @default(0)
  discount  Decimal @default(0)
  total     Decimal @default(0)

  /// Payments
  paidAmount    Decimal @default(0)
  paymentMethod String?

  /// Points
  pointsEarned   Int @default(0)
  pointsRedeemed Int @default(0)

  /// Notes
  notes String?

  /// Source
  source String? /// pos, online, api

  /// Relations
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client   Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items    ProductOrder[]
  payments Payment[]

  @@index([tenantId])
  @@index([tenantId, orderNumber])
  @@index([tenantId, clientId])
  @@index([status])
  @@map("orders")
}

model InventoryTransaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  productId String
  tenantId  String

  /// Transaction details
  type        InventoryTransactionType
  quantity    Int /// Positive for additions, negative for deductions
  previousQty Int
  newQty      Int

  /// Reference
  orderId       String?
  appointmentId String?
  reason        String? /// restock, sale, adjustment, return, etc.
  notes         String?

  /// Product
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@map("inventory_transactions")
}

enum OrderStatus {
  pending
  processing
  completed
  cancelled
  refunded
  partially_refunded
}

enum OrderType {
  sale
  return
  exchange
  quote
}

enum InventoryTransactionType {
  restock
  sale
  return
  adjustment
  transfer
  damaged
  expired
}

// Email Marketing Campaigns
enum CampaignStatus {
  draft
  active /// For re-engagement campaigns that run automatically
  scheduled
  sending
  sent
  cancelled
  failed
}

enum CampaignType {
  newsletter
  promotion
  announcement
  reminder
  review_request
  loyalty
  reengagement
  custom
}

model EmailCampaign {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String

  /// Campaign details
  name         String
  subject      String
  previewText  String? /// Preview text shown in email inbox
  content      String /// HTML content
  campaignType CampaignType
  status       CampaignStatus @default(draft)

  /// Re-engagement campaign settings
  inactiveDaysThreshold Int? /// Days of inactivity to target (e.g., 30, 60, 90)
  linkedPromotionId     String? /// Optional promotion to include in email
  linkedPromotion       Promotion? @relation(fields: [linkedPromotionId], references: [id], onDelete: SetNull)

  /// Scheduling
  scheduledAt DateTime?
  sentAt      DateTime?

