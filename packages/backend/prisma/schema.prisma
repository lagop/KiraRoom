}

enum NifType {
  nif /// DNI Ã¢â‚¬â€ 8 digits + letter
  cif /// Company Ã¢â‚¬â€ letter + 7 digits + control
  nie /// Foreign resident Ã¢â‚¬â€ X/Y/Z + 7 digits + letter
  passport
  other
}

model FiscalChainState {
  tenantId        String
  fiscalMode      FiscalMode
  lastHash        String?
  lastNumber      String?
  lastSubmittedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, fiscalMode])
  @@index([fiscalMode, lastSubmittedAt])
  @@map("fiscal_chain_states")
}

// ----------------------------------------------------------------------------
// P2B Ã¢â‚¬â€ Accounting integrations (Holded / Sage / A3 / NCS)
// ----------------------------------------------------------------------------

model AccountingConnection {
  id                    String              @id @default(uuid())
  tenantId              String              @unique
  provider              AccountingProvider
  /// OAuth tokens cifrados en reposo (EncryptionService)
  encryptedAccessToken  String              @db.Text
  encryptedRefreshToken String?             @db.Text
  expiresAt             DateTime?
  externalCompanyId     String?
  isActive              Boolean             @default(true)
  lastSyncAt            DateTime?
  lastError             String?             @db.Text
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syncLogs              AccountingSyncLog[]

  @@index([provider, isActive])
  @@map("accounting_connections")
}

model AccountingSyncLog {
  id           String                @id @default(uuid())
  tenantId     String
  invoiceId    String
  provider     AccountingProvider
  action       String /// 'sync' | 'retry' | 'unlink' | 'refresh_token'
  status       String /// 'ok' | 'error' | 'skipped'
  externalId   String?
  errorMessage String?               @db.Text
  payload      Json?
  createdAt    DateTime              @default(now())
  connection   AccountingConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  connectionId String?

  @@index([tenantId, createdAt])
  @@index([invoiceId])
  @@map("accounting_sync_logs")
}

enum AccountingProvider {
  holded
  sage
  a3
  ncs
}

// GDPR data-subject-request audit trail (Art. 30 RGPD). One row per
// export or anonymize request. Used both for the customer's right of
// access (Art. 15) and right to erasure (Art. 17), plus for proving
// compliance during an AEPD audit.
model GdprRequest {
  id          String            @id @default(uuid())
  tenantId    String
  action      GdprAction
  status      GdprRequestStatus @default(processing)
  actorId     String
  ipAddress   String?
  createdAt   DateTime          @default(now())
  completedAt DateTime?
  notes       String?
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@map("gdpr_requests")
}

enum GdprAction {
  export
  anonymize
}

enum GdprRequestStatus {
  processing
  completed
  failed
}

// Bug reports submitted from the in-app "Ã°Å¸ÂÅ¾ Report a bug" widget
// (or anonymously, e.g. from the login/marketing pages). The SaaS
// admin dashboard reads these rows; the founder also receives an
// email copy via BugReportService for redundancy.
model BugReport {
  id           String          @id @default(uuid())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  /// Optional Ã¢â‚¬â€ anonymous reports from logged-out users have no tenant.
  tenantId     String?
  /// Optional Ã¢â‚¬â€ anonymous reports have no user.
  authorId     String?
  subject      String
  description  String          @db.Text
  currentUrl   String?
  appVersion   String?
  email        String?
  context      Json            @default("{}")
  status       BugReportStatus @default(open)
  /// Optional Ã¢â‚¬â€ when a SaaS owner triages the report.
  resolvedById String?
  resolvedAt   DateTime?
  resolution   String?         @db.Text
  tenant       Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  author       User?           @relation("BugReportAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([tenantId, createdAt])
  @@map("bug_reports")
}

enum BugReportStatus {
  open
  triaged
  in_progress
  resolved
  wont_fix
  duplicate
}

// P2A-receptionist-v2 H-4 — virtual-receptionist chat channels.
// `web` is the in-app web chat (Widget).
// `whatsapp` / `facebook` / `instagram` are Meta platforms, all served
// via the same Graph API endpoint (differentiated by metadata.platform).
// `telegram` is the Telegram Bot API.
enum ChatChannel {
  web
  whatsapp
  facebook
  instagram
  telegram
}

// ============================================================================
// P2A-platform-llm: single platform-wide LLM provider config
// ============================================================================
// A singleton row (id = "global") that holds the API key and default model
// the platform uses for the Virtual Receptionist. Salon owners do NOT see
// this; only `saas_owner` role can read/write. The apiKey is encrypted
// at rest with the existing EncryptionService (AES-256-GCM, KMS-backed).
model PlatformLlmConfig {
  id              String   @id @default("global")
  provider        String   @default("anthropic") // "anthropic" | "openai" | ...
  // P2A-platform-llm: AES-256-GCM ciphertext of the API key. Decrypt with
  // EncryptionService.decrypt(). Never expose via API; only the
  // last-4-chars hash is returned to the admin UI.
  apiKeyEncrypted String   @db.Text
  defaultModel    String   @default("claude-haiku-4-5")
  // Optional fields that the provider factory needs (e.g. MiniMax
  // requires MINIMAX_BASE_URL).
  baseUrl         String?
  // P2A-anthropic-workspace: Identity-linked Anthropic keys (created
  // from console.anthropic.com since late 2025) require this header
  // in every request. Not sensitive — visible in the console.
  workspaceId     String?
  updatedAt       DateTime @updatedAt
  updatedBy       String?
}

// ============================================================================
// P2A-staff-copilot: per-user chat thread + per-message + pending-action queue
// ============================================================================
// Conversations are scoped per (user, tenant) so the staff copilot is
// never shared with the customer chatbot. The thread is owned by
// exactly one `User`; messages reference that thread. Pending actions
// (write tools that need human approval) live in their own table so they
// can survive a panel reload and be approved from the notification bell.
model AssistantConversation {
  id        String             @id @default(cuid())
  tenantId  String
  userId    String
  sessionId String? // null = persistent thread; non-null = ephemeral panel session
  title     String? // auto-generated by LLM after ~5 turns; null until then
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  messages  AssistantMessage[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, sessionId])
  @@index([tenantId, updatedAt])
  @@index([userId, updatedAt])
  @@map("assistant_conversations")
}

enum AssistantMessageRole {
  user // the salon staff typed something
  assistant // the LLM replied
  tool // tool-call result attached to the assistant message
  approval // a pending-action card; points to ActionApproval
  system // not used in v1; reserved for future system injections
}

model AssistantMessage {
  id              String               @id @default(cuid())
  conversationId  String
  role            AssistantMessageRole
  content         String               @db.Text // text or tool-call JSON
  toolName        String?
  toolInput       Json?
  toolResult      Json?
  pendingActionId String? // when role=approval
  createdAt       DateTime             @default(now())

  conversation  AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  pendingAction ActionApproval?       @relation(fields: [pendingActionId], references: [id], onDelete: SetNull)
  feedback      CopilotFeedback[]

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

// Pending actions: every write tool returns a preview the human must
// approve. Defaults to 5-minute expiry so a forgotten card doesn't
// haunt the dashboard.
model ActionApproval {
  id             String               @id @default(cuid())
  tenantId       String
  userId         String
  toolName       String
  toolInput      Json
  status         ActionApprovalStatus @default(pending)
  preview        String? // human-readable summary shown in the UI
  expiresAt      DateTime
  createdAt      DateTime             @default(now())
  resolvedAt     DateTime?
  resultSnapshot Json? // tool result if executed
  resolvedById   String? // user who approved/rejected (null if expired)

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User               @relation("ActionApprovalCreator", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User?              @relation("ActionApprovalResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  messages   AssistantMessage[]

  @@index([userId, status, expiresAt])
  @@index([tenantId, createdAt])
  @@map("action_approvals")
}

enum ActionApprovalStatus {
  pending
  approved
  rejected
  expired
  executed
}

// P2A-staff-copilot-sprint16: thumbs up/down feedback on assistant
// replies. Persisted so the platform team can review quality during
// the soft-launch without forcing users to file a bug report.
model CopilotFeedback {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  messageId String // the assistant message being rated
  rating    Int // -1 = 👎, 1 = 👍
  comment   String? // optional free-text (max 500 chars)
  createdAt DateTime @default(now())

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User             @relation("CopilotFeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)
  message AssistantMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([messageId])
  @@index([rating])
  @@map("copilot_feedback")
}

/// Product telemetry for the activation funnel.
///
/// There was none: the marketing site had Plausible and the app had
/// nothing, so signup -> wizard -> first booking could not be measured and
/// the claim that onboarding reduces 7-day churn was unverifiable. Kept
/// deliberately small -- a name, an optional tenant, a JSON payload -- so
/// adding an event is one line and never a migration.
model ProductEvent {
  id        String   @id @default(uuid())
  /// Snake-case event name, e.g. `tenant_signed_up`, `first_booking_received`.
  name      String
  /// Null for events that happen before a tenant exists.
  tenantId  String?
  props     Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([tenantId, name])
  @@map("product_events")
}
