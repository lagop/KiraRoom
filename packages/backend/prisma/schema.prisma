}

model Service {
  id                  String                @id @default(uuid())
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  tenantId            String
  name                String
  description         String?
  category            ServiceCategory
  duration            Int
  price               Decimal
  currency            String                @default("EUR")
  isActive            Boolean               @default(true)
  requiresApproval    Boolean               @default(false)
  hasProcessingTime   Boolean               @default(false) /// e.g., coloring, keratin, perms need processing time
  processingDuration  Int? /// Duration of processing time in minutes (default from service duration)
  maxAdvanceBooking   Int                   @default(30)
  minAdvanceBooking   Int                   @default(2)
  bufferTime          Int                   @default(15)
  isOnlineBookable    Boolean               @default(true)
  isMobile            Boolean               @default(false)
  /// Deposit settings
  depositRequired     Boolean               @default(false)
  depositAmount       Decimal?
  depositPercentage   Decimal?
  images              Json                  @default("[]")
  prerequisites       Json                  @default("[]")
  staff               Json                  @default("[]")
  equipment           Json                  @default("[]")
  products            Json                  @default("[]")
  tags                Json                  @default("[]")
  seoTitle            String?
  seoDescription      String?
  professionals       ProfessionalService[]
  appointments        Appointment[]
  appointmentServices AppointmentService[]
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, category])
  @@map("services")
}

model Professional {
  id                  String                 @id @default(uuid())
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  tenantId            String
  userId              String?                @unique
  firstName           String
  lastName            String
  email               String                 @unique
  phone               String?
  profileImage        String?
  bio                 String?
  specialties         Json                   @default("[]")
  /// Portfolio fields
  portfolioImages     Json                   @default("[]")
  yearsExperience     Int?
  languages           Json                   @default("[]")
  certifications      Json                   @default("[]")
  /// End of portfolio fields
  isActive            Boolean                @default(true)
  isOwner             Boolean                @default(false)
  position            String?
  commissionRate      Decimal?
  hireDate            DateTime
  terminationDate     DateTime?
  workingHours        Json                   @default("[]")
  availability        Json                   @default("{}")
  settings            Json                   @default("{}")
  stats               Json                   @default("{}")
  services            ProfessionalService[]
