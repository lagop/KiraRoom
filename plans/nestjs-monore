### Backend (Nest.js) Example
```typescript
// packages/backend/src/appointments/appointments.controller.ts
import { Controller, Post, Body } from '@nestjs/common';
import { AppointmentSchema } from '@kira-room/shared/validation/appointment';
import { AppointmentsService } from './appointments.service';

@Controller('appointments')
export class AppointmentsController {
  constructor(private readonly appointmentsService: AppointmentsService) {}

  @Post()
  async create(@Body() createAppointmentDto: CreateAppointmentDto) {
    const validatedData = AppointmentSchema.parse(createAppointmentDto);
    return this.appointmentsService.create(validatedData);
  }
}

// packages/backend/src/appointments/appointments.module.ts
import { Module } from '@nestjs/common';
import { TypeOrmModule } from '@nestjs/typeorm';
import { Appointment } from './appointment.entity';
import { AppointmentsService } from './appointments.service';
import { AppointmentsController } from './appointments.controller';

@Module({
  imports: [TypeOrmModule.forFeature([Appointment])],
  controllers: [AppointmentsController],
  providers: [AppointmentsService],
  exports: [AppointmentsService],
})
export class AppointmentsModule {}
```

### Frontend (Next.js) Example
```typescript
// packages/frontend/src/lib/api/appointments.ts
import { Appointment, AppointmentSchema } from '@kira-room/shared/types/appointment';

export class AppointmentsAPI {
  async create(appointmentData: CreateAppointmentDto): Promise<Appointment> {
    const response = await fetch('/api/appointments', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(appointmentData),
    });
    
    const data = await response.json();
    return AppointmentSchema.parse(data);
  }
}

// packages/frontend/src/components/AppointmentForm.tsx
import { useState } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { AppointmentSchema, CreateAppointmentDto } from '@kira-room/shared/types/appointment';

export function AppointmentForm() {
  const [isSubmitting, setIsSubmitting] = useState(false);
  
  const { register, handleSubmit, formState: { errors } } = useForm<CreateAppointmentDto>({
    resolver: zodResolver(AppointmentSchema),
  });

  const onSubmit = async (data: CreateAppointmentDto) => {
    setIsSubmitting(true);
    try {
      await appointmentsAPI.create(data);
      // Handle success
    } catch (error) {
      // Handle error
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    <form onSubmit={handleSubmit(onSubmit)}>
      {/* Form fields using shared validation */}
    </form>
  );
}
```

## Beneficios Específicos para el Proyecto

### 1. **Consistency Across Frontend/Backend**
- Same validation logic = no discrepancies
- Shared TypeScript interfaces = no mismatches
- Consistent error handling

### 2. **Easier Development for Solo Dev**
- Single development environment
- Hot reload for both frontend and backend
- Shared tooling and scripts

### 3. **Better Error Prevention**
- TypeScript types shared = compile-time error detection
- Validation schemas shared = consistent validation
- Business logic in shared package = no duplication

### 4. **Future-Proof Architecture**
- Easy to add mobile app later (share types)
- Easy to add admin dashboard (share components)
- Easy to add API for partners (well-structured)

## Timeline Impact

