# KiraRoom production environment template.
#
# Copy this to /opt/kiraroom/.env.production on the VPS (chmod 600) and
# fill in real values BEFORE the first deploy. CI never sees this file.
#
# Generate secrets with:
#   openssl rand -base64 48            # JWT_SECRET, OAUTH_STATE_SECRET, etc.
#   openssl rand -hex 32               # 32-byte hex keys
#
# ─────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# Public hostnames — used for CORS, redirects, OAuth callbacks, Stripe
# portal success/cancel URLs, email links. Three subdomains:
APP_BASE_URL=https://app.kiraroom.net
API_BASE_URL=https://api.kiraroom.net
ADMIN_BASE_URL=https://admin.kiraroom.net
FRONTEND_URL=https://app.kiraroom.net
CORS_ALLOWED_ORIGINS=https://app.kiraroom.net,https://admin.kiraroom.net

# ─────────────────────────────────────────────────────────────────────
# Database (SEC-3: validated at startup in non-prod, required in prod)
# ─────────────────────────────────────────────────────────────────────
POSTGRES_USER=kiraroom
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://kiraroom:__SET_ME__@postgres:5432/kiraroom

# ─────────────────────────────────────────────────────────────────────
# Auth — SEC-1: 32+ random chars, not a placeholder
# ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────────
# Stripe (SEC-3: STRIPE_WEBHOOK_SECRET required in production)
# ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_UNVERIFIED_STRIPE_WEBHOOK=

# ─────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─────────────────────────────────────────────────────────────────────
# LLM providers — at least one must be set for the copilot + virtual
# receptionist to work. The platform can mix-and-match per tenant.
#
# MiniMax is the primary key (Anthropic-API-compatible gateway).
# Without it, the Staff Copilot and virtual receptionist return errors.
# The other three are read for fallback / per-tenant overrides.
# ─────────────────────────────────────────────────────────────────────
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Provider selector. Must match a key above (or the per-tenant
# VirtualReceptionistConfig wins).
DEFAULT_LLM_PROVIDER=MiniMax
DEFAULT_LLM_MODEL=claude-haiku-4-5
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.7

# ─────────────────────────────────────────────────────────────────────
# WhatsApp Cloud API + Google Business (P0 features)
# ─────────────────────────────────────────────────────────────────────
META_TOKEN_ENCRYPTION_KEY=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=v20.0

GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────
# OAuth state secret for accounting integrations (Holded, Sage, A3, NCS).
# 16+ random chars, required at startup in NODE_ENV=production.
# ─────────────────────────────────────────────────────────────────────
OAUTH_STATE_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Notifications
# ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─────────────────────────────────────────────────────────────────────
# Fiscal mode — keep as "sandbox" until the AEAT cert is uploaded and
# the tax-compliance runbook §11 has been signed off.
# ─────────────────────────────────────────────────────────────────────
FISCAL_MODE=sandbox

# ─────────────────────────────────────────────────────────────────────
# Logging / observability
# ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─────────────────────────────────────────────────────────────────────
# Image tag — what tag the VPS should pull from ghcr.io.
# ─────────────────────────────────────────────────────────────────────
# Set to 'latest' for normal deploys. The CI workflow pushes both
# ':latest' and ':<short-sha>' tags on every push to main, so you
# can pin a specific version (e.g. '5fb42f8') here to roll back.
IMAGE_TAG=latest

# Container registry. CI pushes here; VPS pulls from here.
# The GHCR packages must be Public visibility for anonymous pull to
# work (set at https://github.com/users/lagop/packages/settings).
# If you prefer Private, swap the IMAGE_NAMESPACE to your org and add
# a 'docker login ghcr.io' step on the VPS with a read:packages PAT.
REGISTRY=ghcr.io
IMAGE_NAMESPACE=lagop

# Nightly pg_dump retention, in days (postgres-backup service). Default 14.
BACKUP_RETENTION_DAYS=14

# Spanish VAT on our own subscription invoices. Requires Stripe Tax to be
# switched on and an origin address set in the Stripe dashboard FIRST --
# enabling it here before that makes every checkout fail.
STRIPE_TAX_ENABLED=false

# Bearer token Prometheus uses to scrape /internal/metrics. Generate with
# openssl rand -hex 32. Must match METRICS_SCRAPE_TOKEN in the observability
# stack. Unset in production means the endpoint refuses rather than opens.
METRICS_SCRAPE_TOKEN=__REPLACE_WITH_openssl_rand_hex_32__
