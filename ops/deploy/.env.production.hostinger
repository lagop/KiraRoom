# Paste the contents of this file (without the header comments) into
# Hostinger Docker Manager -> your KiraRoom app -> Environments.
#
# Format: one KEY=value per line. Lines starting with # are ignored.
# The three "required" secrets are marked REQUIRED below; if any of
# those is missing, docker compose fails fast before any container
# starts.
#
# To regenerate the secrets, run:
#   openssl rand -base64 48
#
# ---------------------------------------------------------------
# REQUIRED (docker compose fails without these)
# ---------------------------------------------------------------
POSTGRES_PASSWORD=__REPLACE_WITH_OPENSSL_RAND_BASE64_24__
JWT_SECRET=__REPLACE_WITH_OPENSSL_RAND_BASE64_48__
# Must be a DIFFERENT value from JWT_SECRET. Unset, refresh tokens end up
# signed with JWT_SECRET and every access token doubles as a refresh token,
# so the backend now refuses to boot without it.
JWT_REFRESH_SECRET=__REPLACE_WITH_A_SECOND_OPENSSL_RAND_BASE64_48__
OAUTH_STATE_SECRET=__REPLACE_WITH_OPENSSL_RAND_BASE64_48__
# Signs the one-click opt-out links in rebooking reminders. The compose
# requires it with no default; it was missing from this file entirely, so
# the deploy ran with it empty.
REBOOKING_OPT_OUT_SECRET=__REPLACE_WITH_OPENSSL_RAND_BASE64_48__

# ---------------------------------------------------------------
# Public hostnames (browsers + Stripe webhooks will read these)
# ---------------------------------------------------------------
APP_BASE_URL=https://app.kiraroom.net
FRONTEND_URL=https://app.kiraroom.net
API_BASE_URL=https://api.kiraroom.net
CORS_ALLOWED_ORIGINS=https://app.kiraroom.net,https://admin.kiraroom.net

# ---------------------------------------------------------------
# Frontend (baked into the JS bundle at runtime -- MUST be the public
# hostnames, not localhost; the browser resolves them by DNS)
# ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.kiraroom.net/api/v1
NEXT_PUBLIC_WS_URL=wss://api.kiraroom.net

# ---------------------------------------------------------------
# LLM (MiniMax is the primary provider)
# ---------------------------------------------------------------
MINIMAX_API_KEY=__REPLACE_WITH_YOUR_MINIMAX_KEY__
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-haiku-4-5
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_MS=1000
LLM_RETRY_MAX_DELAY_MS=10000

# ---------------------------------------------------------------
# Stripe (start with sk_test_* -- switch to sk_live_* before billing
# real tenants)
# ---------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE

# ---------------------------------------------------------------
# Auth token lifetimes (override only if you know why)
# ---------------------------------------------------------------
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------
# Image registry (default: ghcr.io/lagop). Override to pin a
# specific version, e.g. IMAGE_TAG=41340c6 for rollback.
# ---------------------------------------------------------------
REGISTRY=ghcr.io
IMAGE_NAMESPACE=lagop
IMAGE_TAG=latest

# ---------------------------------------------------------------
# Optional integrations -- leave empty until you activate each
# ---------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_TOKEN_ENCRYPTION_KEY=
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=v20.0
# Google Business Profile OAuth. These are the names social-integrations
# reads; GOOGLE_BUSINESS_CLIENT_ID/_SECRET were documented here for a while
# and matched nothing in the code, so the consent URL was built with
# client_id=undefined.
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=
# Verified sender for Resend. The code falls back to noreply@yourdomain.com,
# which Resend rejects, so leaving this empty means no e-mail is delivered
# even with a valid API key.
EMAIL_FROM=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
MINIMAX_BASE_URL=
ICS_TOKEN_SECRET=
LOG_LEVEL=info

# ---------------------------------------------------------------
# CI escape hatches -- KEEP EMPTY in production. Set to "1" only
# in CI test envs to bypass the corresponding startup validator.
# ---------------------------------------------------------------
ALLOW_WEAK_JWT_SECRET=
ALLOW_UNVERIFIED_STRIPE_WEBHOOK=
ALLOW_WEAK_OAUTH_STATE_SECRET=

# Nightly pg_dump retention, in days (postgres-backup service). Default 14.
BACKUP_RETENTION_DAYS=14

# Spanish VAT on our own subscription invoices. Requires Stripe Tax to be
# switched on and an origin address set in the Stripe dashboard FIRST --
# enabling it here before that makes every checkout fail.
STRIPE_TAX_ENABLED=false

# Bearer token Prometheus uses to scrape /internal/metrics. Generate with
# openssl rand -hex 32. Must match METRICS_SCRAPE_TOKEN in the observability
# stack. Unset in production means the endpoint refuses rather than opens.
METRICS_SCRAPE_TOKEN=__REPLACE_WITH_openssl_rand_hex_32__

# Platform owner account, read by `npm run db:seed:saas` on first deploy.
# The seed refuses to run without these, and refuses placeholder values: this
# account reads across every tenant. Password must be 12+ chars.
SAAS_OWNER_EMAIL=
SAAS_OWNER_PASSWORD=
