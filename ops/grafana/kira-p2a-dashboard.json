{
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "datasource", "uid": "grafana"}, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"}]},
  "description": "P2A-receptionist-v2 virtual-receptionist metrics. Time series use Prometheus query language against the /internal/metrics endpoint exposed by the backend.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "timeseries",
      "title": "AI calls per minute (by status)",
      "description": "Rate of LLM calls. Success = normal flow; cap_exceeded = tenant hit the monthly cap and was short-circuited to the FAQ cache + handoff.",
      "id": 1,
      "datasource": {"type": "prometheus", "uid": "kira-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "reqpm",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}
      },
      "targets": [
        {"refId": "AI_SUCCESS", "expr": "sum(rate(vrm_ai_calls_total{status=\"success\"}[5m]))"},
        {"refId": "AI_CAP", "expr": "sum(rate(vrm_ai_calls_total{status=\"cap_exceeded\"}[5m]))"},
        {"refId": "AI_UNL", "expr": "sum(rate(vrm_ai_calls_total{status=\"unlimited\"}[5m]))"}
      ]
    },
    {
      "type": "timeseries",
      "title": "AI fair-use cap hits (per plan, per min)",
      "description": "Tenants hitting the Esencial cap means they need the upsell to Pro or ai_expansion. Alert when this rate > 0 sustained.",
      "id": 2,
      "datasource": {"type": "prometheus", "uid": "kira-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "reqpm",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}
      },
      "targets": [
        {"refId": "ESENCIAL", "expr": "sum(rate(vrm_ai_fairuse_cap_hit_total{plan=\"esencial\"}[5m]))"},
        {"refId": "PRO", "expr": "sum(rate(vrm_ai_fairuse_cap_hit_total{plan=\"pro\"}[5m]))"},
        {"refId": "EMPRESA", "expr": "sum(rate(vrm_ai_fairuse_cap_hit_total{plan=\"empresa\"}[5m]))"}
      ]
    },
    {
      "type": "stat",
      "title": "FAQ cache hit rate (last 1h)",
      "description": "Total hits / (hits + misses). 80% means 80% of FAQ queries were served without an LLM call (saves money and latency).",
      "id": 3,
      "datasource": {"type": "prometheus", "uid": "kira-prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0.5},
              {"color": "green", "value": 0.7}
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "targets": [
        {"refId": "FAQ_HIT_RATE", "expr": "sum(rate(vrm_faq_cache_hit_total[1h])) / (sum(rate(vrm_faq_cache_hit_total[1h])) + sum(rate(vrm_faq_cache_miss_total[1h])))"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Add-on provisioning rate (per source)",
      "description": "Track add-on purchases. stripe = paid; manual = SaaS-admin grants. A spike in manual may indicate a support escalation.",
      "id": 4,
      "datasource": {"type": "prometheus", "uid": "kira-prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 8},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "reqpm",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}
      },
      "targets": [
        {"refId": "PROV_STRIPE", "expr": "sum by(key) (rate(vrm_addon_provisioned_total{source=\"stripe\"}[5m]))"},
        {"refId": "PROV_MANUAL", "expr": "sum by(key) (rate(vrm_addon_provisioned_total{source=\"manual\"}[5m]))"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Add-on cancellations rate",
      "description": "Complement to provisioning. A spike here = churn risk per add-on.",
      "id": 5,
      "datasource": {"type": "prometheus", "uid": "kira-prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 8},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "reqpm",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}
      },
      "targets": [
        {"refId": "CANC", "expr": "sum by(key) (rate(vrm_addon_cancelled_total[5m]))"}
      ]
    }
  ],
